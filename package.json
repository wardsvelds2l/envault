{
  "name": "envault",
  "version": "0.2.0",
  "description": "Encrypt .env files with XChaCha20-Poly1305 + Argon2id so they can be safely committed to git",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "envault": "dist/envault.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "ncc build src/cli.ts -o dist --quiet && node -e \"require('fs').renameSync('dist/index.js', 'dist/envault.js')\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" \"__tests__/**/*.ts\" \"scripts/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"__tests__/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"__tests__/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "all": "npm run typecheck && npm run lint && npm run test && npm run build && npm run bundle",
    "bench": "esbuild --bundle --platform=node --format=esm --target=node22 scripts/bench.ts | node",
    "clean": "rm -rf dist coverage",
    "prebuild": "npm run clean",
    "prepublishOnly": "npm run all"
  },
  "keywords": [
    "env",
    "dotenv",
    "encryption",
    "xchacha20",
    "xchacha20-poly1305",
    "authenticated-encryption",
    "argon2id",
    "argon2",
    "kdf",
    "secret-management",
    "team-secrets",
    "no-saas",
    "local-first",
    "encryption-cli",
    "vault-file",
    "vault",
    "secrets",
    "cli"
  ],
  "author": {
    "name": "wardsvelds2l",
    "url": "https://github.com/wardsvelds2l"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wardsvelds2l/envault.git"
  },
  "homepage": "https://github.com/wardsvelds2l/envault#readme",
  "bugs": {
    "url": "https://github.com/wardsvelds2l/envault/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9",
    "pnpm": ">=8",
    "yarn": ">=1.22"
  },
  "dependencies": {
    "@noble/ciphers": "^1.0.0",
    "@noble/hashes": "^1.5.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vercel/ncc": "^0.38.1",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8"
  }
}
