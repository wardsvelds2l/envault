{
  "name": "envault",
  "version": "0.1.0",
  "description": "Encrypt .env files with XChaCha20-Poly1305 + Argon2id so they can be safely committed to git",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "envault": "dist/envault.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "ncc build src/cli.ts -o dist --quiet && node -e \"require('fs').renameSync('dist/index.js', 'dist/envault.js')\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "all": "npm run lint && npm run typecheck && npm run test && npm run build && npm run bundle"
  },
  "keywords": [
    "env",
    "dotenv",
    "encryption",
    "xchacha20",
    "argon2id",
    "vault",
    "secrets",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@noble/ciphers": "^1.0.0",
    "@noble/hashes": "^1.5.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vercel/ncc": "^0.38.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8"
  }
}
